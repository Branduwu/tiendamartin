{
  "name": "smartretail",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.27.1",
  "scripts": {
    "lint": "node -e \"const {spawnSync}=require('node:child_process');for(const args of [['--filter','@smartretail/mobile','run','lint'],['--filter','@smartretail/web','run','lint'],['--filter','@smartretail/domain','run','lint'],['--filter','@smartretail/contracts','run','lint'],['--filter','@smartretail/application','run','lint'],['--filter','@smartretail/database','run','lint']]){const r=spawnSync(process.execPath,[process.env.npm_execpath,...args],{stdio:'inherit'});if(r.error)throw r.error;if(r.status!==0)process.exit(r.status??1)}\"",
    "typecheck": "node -e \"const {spawnSync}=require('node:child_process');for(const args of [['--filter','@smartretail/web','run','typecheck'],['--filter','@smartretail/mobile','run','typecheck'],['--filter','@smartretail/domain','run','typecheck'],['--filter','@smartretail/contracts','run','typecheck'],['--filter','@smartretail/application','run','typecheck'],['--filter','@smartretail/database','run','typecheck']]){const r=spawnSync(process.execPath,[process.env.npm_execpath,...args],{stdio:'inherit'});if(r.error)throw r.error;if(r.status!==0)process.exit(r.status??1)}\"",
    "format:check": "prettier --check package.json .prettierrc.json vitest.config.mts playwright.config.ts \"apps/*/package.json\" \"apps/*/eslint.config.mjs\" \"apps/**/*.{ts,tsx,js,jsx,css}\" \"packages/**/*.{ts,mts,mjs,json}\" \"scripts/audit-deps*.mjs\" \"scripts/test-integration-required.mjs\" \"e2e/**/*.{ts,tsx}\"",
    "audit:deps": "node --test scripts/audit-deps.test.mjs && node scripts/audit-deps.mjs",
    "check": "node -e \"const {spawnSync}=require('node:child_process');for(const args of [['run','format:check'],['run','lint'],['run','typecheck'],['run','test'],['run','audit:deps']]){const r=spawnSync(process.execPath,[process.env.npm_execpath,...args],{stdio:'inherit'});if(r.error)throw r.error;if(r.status!==0)process.exit(r.status??1)}\"",
    "test": "vitest run",
    "test:integration:required": "node scripts/test-integration-required.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:visual": "playwright test e2e/visual.spec.ts",
    "e2e:update-snapshots": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.63.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.13.1 <25",
    "pnpm": "11.27.1"
  }
}
