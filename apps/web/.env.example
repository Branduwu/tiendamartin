# Copy to .env.local; use the project's PUBLIC publishable key only.
# Server configuration. Production: https://app.smartretailapp.live
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server only. Apply migrations 001–005 through the CLI before provisioning LOGIN.
# Cloud: copy the actual Transaction Pooler host from Connect; port 6543,
# user smartretail_api.<project-ref>, strong password, sslmode=verify-full.
# This loopback URL is for development only, never for Vercel production.
DATABASE_URL=postgresql://smartretail_api:REPLACE_ME@localhost:5432/SMARTRETAIL
