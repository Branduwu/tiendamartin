{
  "name": "@smartretail/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios"
  },
  "dependencies": {
    "expo": "57.0.24",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "eslint-config-prettier": "10.1.8",
    "@types/react-native__assets-registry": "0.84.0",
    "@types/react": "19.2.14",
    "expo-doctor": "1.21.1",
    "typescript": "6.0.3"
  }
}
